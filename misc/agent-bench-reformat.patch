diff --git a/.pre-commit-config.yaml b/.pre-commit-config.yaml
new file mode 100644
index 0000000..6624634
--- /dev/null
+++ b/.pre-commit-config.yaml
@@ -0,0 +1,19 @@
+# Install: pip install pre-commit && pre-commit install
+# Run on everything once: pre-commit run --all-files
+repos:
+  - repo: https://github.com/astral-sh/ruff-pre-commit
+    rev: v0.8.4
+    hooks:
+      - id: ruff
+        args: [--fix]
+      - id: ruff-format
+
+  - repo: https://github.com/scop/pre-commit-shfmt
+    rev: v3.10.0-2
+    hooks:
+      - id: shfmt
+        args: [-w, -i, "2", -ci]
+
+# jobs/, logs/, .hf_cache/ are excluded for ruff via pyproject.toml;
+# exclude them globally here too so shfmt never walks run artifacts.
+exclude: ^(jobs/|logs/|\.hf_cache/|data/results/)
